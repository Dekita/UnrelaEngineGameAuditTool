<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DekUnrealGameAudit</AssemblyName>
    <RootNamespace>DekUnrealGameAudit</RootNamespace>
    <!-- Build\bin\/Build\obj\ output location is set in Directory.Build.props, shared with
         DekUnrealGameAudit.Gui.csproj - see the comment there. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DekUnrealGameAudit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gui\ and Tests\ are separate sibling projects nested inside this project's own folder -
         without this, the default **/*.cs glob here would also try to compile their code (WPF
         references it doesn't have, xunit attributes it doesn't reference). -->
    <Compile Remove="Gui\**" />
    <None Remove="Gui\**" />
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets DekUnrealGameAudit.Tests unit-test small internal helpers (e.g. CLI flag parsing/validation)
         without making them public API just for testability. -->
    <InternalsVisibleTo Include="DekUnrealGameAudit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <!-- 
      CUE4Parse pulls in Microsoft.Bcl.Memory 9.0.0, which has a known high-severity advisory
      (GHSA-73j8-2gch-69rq). Pin a patched version directly until CUE4Parse bumps its own reference. 
    -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

</Project>
