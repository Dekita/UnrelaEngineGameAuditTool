<Window
    x:Class="DekUnrealGameAudit.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DekUnrealGameAudit.Gui.Views"
    Title="Unreal Game Audit"
    Width="1034"
    Height="780"
    MinWidth="1034"
    MinHeight="780"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowStartupLocation="CenterScreen"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="{DynamicResource DefaultFontFamily}">
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavSection" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border
                                x:Name="AccentBar"
                                Width="3"
                                Margin="0,4"
                                HorizontalAlignment="Left"
                                Background="{StaticResource NexusOrangeBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!--  Declared before IsChecked so a checked item stays fully highlighted even
                                  while hovered - later triggers win ties on the same target property.  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NexusOrangeFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NexusOrangeMutedBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource NexusOrangeBrush}" />
                            </Trigger>
                            <!--  The theme's own default focus adorner never appears on this custom template
                                  (verified live - Tab-ing here left a nav item with zero visible difference),
                                  so keyboard focus needs its own explicit cue distinct from hover/checked.  -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NexusOrangeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,16,12,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!--  Same hover/checked language as NavItemStyle (so it's just as obviously clickable as any
              other tab), sized for the app logo's larger icon and two-line title instead of a single
              icon+label row.  -->
        <Style x:Key="LogoNavItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavSection" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,14" />
            <Setter Property="Margin" Value="8,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border
                                x:Name="AccentBar"
                                Width="3"
                                Margin="0,10"
                                HorizontalAlignment="Left"
                                Background="{StaticResource NexusOrangeBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NexusOrangeFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NexusOrangeMutedBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource NexusOrangeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NexusOrangeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  The app logo doubles as the Guide's nav item - same hover/checked highlight as every
                      other tab below, so it's just as obvious that clicking it changes the content.  -->
                <RadioButton
                    x:Name="NavGuide"
                    Grid.Row="0"
                    Checked="NavItem_Checked"
                    Style="{StaticResource LogoNavItemStyle}"
                    Tag="Guide"
                    ToolTip="Guide"
                    AutomationProperties.Name="Guide">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            FontSize="26"
                            Foreground="{StaticResource NexusOrangeBrush}"
                            Symbol="Fingerprint24" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Unreal Game Audit" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Opacity="0.6"
                                Text="by Dekita" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>

                <StackPanel Grid.Row="1">
                    <!--  Scope Rules and Quick Actions lead the sidebar rather than following Game/Mods/
                          Headers in domain order: Scope Rules is configuration the other sections depend on
                          (what counts as Game vs Mod vs Ignore), and Quick Actions is the one-click path most
                          returning users reach for every time - both belong before the granular, step-by-step
                          tools, not after them.  -->
                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Margin="12,4,12,4" Text="SCOPE RULES" />
                    <RadioButton
                        x:Name="NavScopeRules"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="ScopeRules"
                        AutomationProperties.Name="Scope Rules">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Scope Rules" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Text="QUICK ACTIONS" />
                    <RadioButton
                        x:Name="NavQuickActions"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="QuickActions"
                        AutomationProperties.Name="Quick Actions">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FlashSettings24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Quick Actions" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Text="GAME" />
                    <RadioButton
                        x:Name="NavHashGameFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="HashGameFiles"
                        AutomationProperties.Name="Hash Game Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentTableSearch24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Hash Game Files" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="NavCompareGameFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="CompareGameFiles"
                        AutomationProperties.Name="Compare Game Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BranchCompare24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Compare Game Files" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Text="MODS" />
                    <RadioButton
                        x:Name="NavHashModFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="HashModFiles"
                        AutomationProperties.Name="Hash Mod Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PuzzlePiece24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Hash Mod Files" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="NavCompareModFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="CompareModFiles"
                        AutomationProperties.Name="Compare Mod Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Compare Mod Files" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Text="HEADERS" />
                    <RadioButton
                        x:Name="NavHashHeaderFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="HashHeaderFiles"
                        AutomationProperties.Name="Hash Header Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CodeBlock24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Hash Header Files" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="NavCompareHeaderFiles"
                        Checked="NavItem_Checked"
                        Style="{StaticResource NavItemStyle}"
                        Tag="CompareHeaderFiles"
                        AutomationProperties.Name="Compare Header Files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BracesVariable24" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Compare Header Files" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource SidebarSectionHeaderStyle}" Text="PROFILES" />
                    <ComboBox Cursor="Hand"
                        x:Name="ProfileCombo"
                        Margin="12,0,12,6"
                        IsEditable="True"
                        SelectionChanged="ProfileCombo_SelectionChanged"
                        ToolTip="Pick a saved profile, or type a new name and click Save"
                        AutomationProperties.Name="Profile" />
                    <TextBlock x:Name="ProfileStatusText"
                        Margin="12,0,12,6"
                        FontSize="11"
                        Opacity="0.75"
                        Text="No saved profile selected."
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                    <Grid Margin="12,0,12,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Cursor="Hand" Height="36"
                            x:Name="SaveProfileButton"
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Secondary"
                            Content="Save"
                            Click="SaveProfile_Click"
                            Icon="{ui:SymbolIcon DocumentSave24}"
                            ToolTip="Save the current fields under this profile name" />
                        <ui:Button Cursor="Hand" Height="36"
                            x:Name="DeleteProfileButton"
                            Grid.Column="1"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Secondary"
                            Content="Delete"
                            Click="DeleteProfile_Click"
                            Icon="{ui:SymbolIcon DeleteDismiss24}"
                            ToolTip="Delete the selected profile" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Content - unpadded on purpose: each view pads its own content internally (see e.g.
              HashGameFilesView's root Grid Margin), rather than relying on this shared wrapper, so a
              scrollable view like GuideTab can still use its own full height/width down to the edge.  -->
        <Grid Grid.Column="1">
            <views:HashGameFilesView x:Name="HashGameFilesTab" Visibility="Collapsed" />
            <views:CompareGameFilesView x:Name="CompareGameFilesTab" Visibility="Collapsed" />
            <views:HashModFilesView x:Name="HashModFilesTab" Visibility="Collapsed" />
            <views:CompareModFilesView x:Name="CompareModFilesTab" Visibility="Collapsed" />
            <views:ScopeRulesView x:Name="ScopeRulesTab" Visibility="Collapsed" />
            <views:HashHeaderFilesView x:Name="HashHeaderFilesTab" Visibility="Collapsed" />
            <views:CompareHeaderFilesView x:Name="CompareHeaderFilesTab" Visibility="Collapsed" />
            <views:QuickActionsView x:Name="QuickActionsTab" Visibility="Collapsed" />
            <views:GuideView x:Name="GuideTab" />
        </Grid>
    </Grid>
</Window>
