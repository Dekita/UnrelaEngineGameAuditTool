<UserControl
    x:Class="DekUnrealGameAudit.Gui.Views.QuickActionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Quick Actions" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
                Before update captures a baseline (game + mods, and headers if configured below) in one click.
                After update rescans, finds that baseline automatically, and saves one combined report - no
                manual manifest picking. These fields are the same Paks/Mods/UE version/AES/scope rules/header
                folder shown on the other tabs - editing them here updates those tabs too.
            </TextBlock>
        </StackPanel>

        <Grid x:Name="FieldsGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PaksFolderLabel" Grid.Row="0" Grid.Column="0" Text="Paks folder" VerticalAlignment="Center" Margin="0,4" />
            <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="PaksFolderBox" Margin="4" PlaceholderText="Folder containing the game's .pak / .utoc+.ucas files" AutomationProperties.LabeledBy="{Binding ElementName=PaksFolderLabel}" />
            <Button Cursor="Hand" Height="36" Grid.Row="0" Grid.Column="2" x:Name="BrowsePaksFolderButton" Content="Browse..." Margin="4" Padding="12,4" FontSize="12" Click="BrowsePaksFolder_Click" AutomationProperties.Name="Browse for Paks folder" />

            <TextBlock x:Name="ModsFolderLabel" Grid.Row="1" Grid.Column="0" Text="Mods folder(s)" VerticalAlignment="Top" Margin="0,8,0,4" />
            <ui:TextBox
                Grid.Row="1" Grid.Column="1"
                x:Name="ModsFolderBox"
                Margin="4"
                Height="54"
                AcceptsReturn="True"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                PlaceholderText="One folder per line - add more mod roots as needed (subfolders are scanned too)"
                AutomationProperties.LabeledBy="{Binding ElementName=ModsFolderLabel}" />
            <Button Cursor="Hand" Height="36" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="4,8,4,4" x:Name="BrowseModsFolderButton" Content="Browse..." Padding="12,4" FontSize="12" Click="BrowseModsFolder_Click" AutomationProperties.Name="Browse for mods folder" />

            <TextBlock x:Name="UeVersionLabel" Grid.Row="2" Grid.Column="0" Text="UE version" VerticalAlignment="Center" Margin="0,4" />
            <ComboBox Cursor="Hand"
                Grid.Row="2" Grid.Column="1"
                x:Name="UeVersionCombo"
                Margin="4"
                IsEditable="True"
                IsTextSearchEnabled="False"
                MaxDropDownHeight="280"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ToolTip="Exact CUE4Parse EGame name - start typing to filter, e.g. GAME_UE5_5"
                AutomationProperties.LabeledBy="{Binding ElementName=UeVersionLabel}" />

            <TextBlock x:Name="AesKeyLabel" Grid.Row="3" Grid.Column="0" Text="AES key(s) (optional)" VerticalAlignment="Top" Margin="0,8,0,4" />
            <ui:TextBox
                Grid.Row="3" Grid.Column="1"
                x:Name="AesKeyBox"
                Margin="4"
                Height="70"
                AcceptsReturn="True"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                PlaceholderText="One per line, GUID:HEXKEY or bare HEXKEY for the main key. Leave blank if unencrypted."
                AutomationProperties.LabeledBy="{Binding ElementName=AesKeyLabel}" />

            <TextBlock x:Name="ScopeRulesLabel" Grid.Row="4" Grid.Column="0" Text="Scope rules (optional)" VerticalAlignment="Center" Margin="0,4" />
            <ui:TextBox
                Grid.Row="4" Grid.Column="1"
                x:Name="ScopeRulesBox"
                Margin="4"
                PlaceholderText="A scope-rules JSON file classifying Paks content as Game/Mod/Ignore. Leave blank to hash everything (unchanged behavior)."
                AutomationProperties.LabeledBy="{Binding ElementName=ScopeRulesLabel}" />
            <Button Cursor="Hand" Height="36" Grid.Row="4" Grid.Column="2" x:Name="BrowseScopeRulesButton" Content="Browse..." Margin="4" Padding="12,4" FontSize="12" Click="BrowseScopeRules_Click" AutomationProperties.Name="Browse for scope rules file" />

            <TextBlock x:Name="HeaderDumpFolderLabel" Grid.Row="5" Grid.Column="0" Text="Header folder (optional)" VerticalAlignment="Center" Margin="0,4" />
            <ui:TextBox
                Grid.Row="5" Grid.Column="1"
                x:Name="HeaderDumpFolderBox"
                Margin="4"
                PlaceholderText="The folder next to UE4SS.dll. Leave blank to skip headers in this capture/audit."
                AutomationProperties.LabeledBy="{Binding ElementName=HeaderDumpFolderLabel}" />
            <Button Cursor="Hand" Height="36" Grid.Row="5" Grid.Column="2" x:Name="BrowseHeaderDumpFolderButton" Content="Browse..." Margin="4" Padding="12,4" FontSize="12" Click="BrowseHeaderDumpFolder_Click" AutomationProperties.Name="Browse for UE4SS folder" />

            <TextBlock x:Name="OutputRootLabel" Grid.Row="6" Grid.Column="0" Text="Output root" VerticalAlignment="Center" Margin="0,4" />
            <ui:TextBox
                Grid.Row="6" Grid.Column="1"
                x:Name="OutputRootBox"
                Margin="4"
                PlaceholderText="Folder to hold run history and the active baseline pointer"
                AutomationProperties.LabeledBy="{Binding ElementName=OutputRootLabel}" />
            <Button Cursor="Hand" Height="36" Grid.Row="6" Grid.Column="2" x:Name="BrowseOutputRootButton" Content="Browse..." Margin="4" Padding="12,4" FontSize="12" Click="BrowseOutputRoot_Click" AutomationProperties.Name="Browse for output root folder" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="HeaderFreshnessNote" Margin="4,0,4,8" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Reminder: UE4SS dumps must be regenerated separately before each capture - a timestamp alone can't prove the dump matches the game version just captured." />

        <TextBlock Grid.Row="3" x:Name="BaselineStatusText" Margin="4,0,4,8" FontSize="12" Opacity="0.85" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="4" Margin="4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Cursor="Hand" Height="36" Grid.Column="0" x:Name="BeforeUpdateButton" Style="{StaticResource PrimaryActionButtonStyle}" Content="Before Update: Save Baseline" Padding="16,6" Click="BeforeUpdate_Click" />
            <ui:Button Cursor="Hand" Height="36"
                Grid.Column="1"
                Margin="8,0,0,0"
                x:Name="AfterUpdateButton"
                Content="After Update: Run Full Audit"
                Appearance="Secondary"
                IsEnabled="False"
                Padding="16,6"
                Click="AfterUpdate_Click" />
            <ui:Button Cursor="Hand" Height="36"
                Grid.Column="2"
                Margin="8,0,0,0"
                x:Name="CancelButton"
                Content="Cancel"
                Appearance="Secondary"
                IsEnabled="False"
                Padding="16,6"
                Click="Cancel_Click" />
            <ui:Button Cursor="Hand" Height="36"
                Grid.Column="3"
                Margin="8,0,0,0"
                x:Name="CopyLogButton"
                Content="Copy Log"
                Appearance="Secondary"
                Padding="16,6"
                Click="CopyLog_Click" />
            <TextBlock
                Grid.Column="4"
                x:Name="StatusText"
                Margin="12,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.8"
                AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <ProgressBar Grid.Row="5" x:Name="ProgressBar" Height="18" Margin="4,0,4,8" Foreground="{StaticResource NexusOrangeBrush}" AutomationProperties.Name="Quick action progress" />

        <Border Grid.Row="6" x:Name="ResultsPanel" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Last audit results" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="ResultGameText" Margin="0,2" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ResultModsText" Margin="0,2" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ResultHeaderText" Margin="0,2" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ResultInventoryText" Margin="0,2" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ResultWarningsText" Style="{StaticResource WarningTextStyle}" Margin="0,4,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ResultSkippedText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.85" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Cursor="Hand" Height="36" x:Name="OpenReportButton" Content="Open Report" Appearance="Secondary" Padding="12,4" FontSize="12" Click="OpenReport_Click" />
                    <ui:Button Cursor="Hand" Height="36" x:Name="OpenFolderButton" Margin="6,0,0,0" Content="Open Folder" Appearance="Secondary" Padding="12,4" FontSize="12" Click="OpenFolder_Click" />
                    <ui:Button Cursor="Hand" Height="36" x:Name="CopyPathButton" Margin="6,0,0,0" Content="Copy Path" Appearance="Secondary" Padding="12,4" FontSize="12" Click="CopyPath_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="7"
            x:Name="LogScrollViewer"
            Margin="4,0,4,4"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <StaticResource x:Key="ScrollBarThumbFill" ResourceKey="NexusOrangeBrush" />
            </ScrollViewer.Resources>
            <TextBox
                x:Name="LogBox"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="False"
                Cursor="Arrow"
                TextWrapping="NoWrap"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                FontFamily="Consolas"
                AutomationProperties.Name="Operation log">
                <TextBox.Resources>
                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="TextControlBackground" />
                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="TextControlBackground" />
                    <StaticResource x:Key="TextControlFocusedBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                </TextBox.Resources>
            </TextBox>
        </ScrollViewer>
    </Grid>
</UserControl>
